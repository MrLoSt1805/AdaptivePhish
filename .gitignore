# Local Python environment and bytecode
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets and local credentials
.env
.env.*
!.env.example
.aws/
credentials/
secrets/
*.pem
*.key

# Tool caches and test outputs
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Logs, packaging outputs, and experiment outputs
*.log
mlruns/
mlartifacts/
*.db
logs/
build/
dist/
*.egg-info/

# Datasets: retain directory placeholders and future DVC pointer files
/data/interim/*
!/data/interim/.gitkeep
!/data/interim/*.dvc
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/*.dvc

# Generated models and reports
/artifacts/*
!/artifacts/.gitkeep
!/artifacts/*.dvc
/reports/figures/*
!/reports/figures/.gitkeep
!/reports/figures/*.dvc
!/reports/figures/temporal_f1_comparison.png
/reports/results/*
!/reports/results/.gitkeep
!/reports/results/*.dvc
!/reports/results/phase3_metrics.json
!/reports/results/phase3_model_comparison.csv
!/reports/results/temporal_evaluation.json
!/reports/results/promotion_decision.json
!/reports/results/*_v2.json
!/reports/results/audit_validation.json
!/reports/results/dataset_quality.json
!/reports/figures/*_v2.png

# Keep future DVC metadata trackable; exclude only local cache/configuration
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local
